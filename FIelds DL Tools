        frame_btns.pack(pady=5, fill="x", padx=20)  # 放置执行按钮容器
        self.btn_run = tk.Button(frame_btns, text="▶ 执行 ID 溯源提取", bg="#4CAF50", fg="white",
                                 font=("Arial", 12, "bold"), command=self.start_download)  # 启动执行按钮
        self.btn_run.pack(side="left", fill="x", expand=True, padx=(0, 5))  # 占据左半侧
        self.btn_stop = tk.Button(frame_btns, text="⏹ 中止任务", bg="#F44336", fg="white", font=("Arial", 12, "bold"),
                                  state=tk.DISABLED, command=self.stop_download)  # 中止任务按钮（初始禁用）
        self.btn_stop.pack(side="right", fill="x", expand=True, padx=(5, 0))  # 占据右半侧

        # --- 区域 7：实时滚动控制台日志 ---
        self.log_area = scrolledtext.ScrolledText(self.root, height=15, state="disabled", bg="#1e1e1e", fg="#00ff00",
                                                  font=("Consolas", 10))  # 采用黑色背景和终端绿色字体的日志框
        self.log_area.pack(fill="both", padx=10, pady=5, expand=True)  # 允许全向自适应拉伸填满底部空间

    def log(self, message):
        """线程安全的 GUI 日志输出函数，负责将日志信息写入界面并自动滚动到底部"""
        self.log_area.config(state="normal")  # 临时解除禁用状态以允许写入文本
        self.log_area.insert(tk.END, message + "\n")  # 在文本末尾追加最新日志并换行
        self.log_area.see(tk.END)  # 调整滚动条使其始终停留在最底部最新日志处
        self.log_area.config(state="disabled")  # 重新设置回只读状态，防止用户误修改日志
        self.root.update_idletasks()  # 强制刷新 GUI 绘制管线，防止密集计算下界面卡顿不刷新

    def load_file_and_columns(self):
        """选择源数据文件，并快速读取前几行提取字段列表，智能预判 ID 所在列"""
        fp = filedialog.askopenfilename(filetypes=[("空间与表格数据", "*.shp *.gpkg *.geojson *.csv *.xlsx")])
        if not fp: return  # 如果用户取消选择则直接退出
        self.input_file.set(fp)  # 将选中的文件绝对路径存入绑定的文本变量中
        try:
            ext = os.path.splitext(fp)[1].lower()  # 获取并格式化输入文件的扩展名
            if ext == '.csv':
                df = pd.read_csv(fp, nrows=5)  # 仅读取前 5 行，极速获取 CSV 文件的列结构
            elif ext == '.xlsx':
                df = pd.read_excel(fp, nrows=5)  # 仅读取前 5 行，快速获取 Excel 文件的列结构
            else:
                df = gpd.read_file(fp, rows=5)  # 仅加载矢量文件的前 5 行，避免大文件造成 I/O 阻塞

            cols = list(df.columns)  # 提取获取到的所有属性表头字段
            self.combo_id_col['values'] = cols  # 将字段列表赋值给界面的字段下拉框
            # 智能识别常见的 OSM 标识字段，自动优先选中
            if 'osm_id' in cols:
                self.combo_id_col.set('osm_id')
            elif 'id' in cols:
                self.combo_id_col.set('id')
            else:
                self.combo_id_col.set(cols[0])  # 若没有匹配则默认选中第 1 个字段
            self.log(f"源文件加载成功。检测到表头结构，请确认 ID 列。")  # 输出成功日志
        except Exception as e:
            messagebox.showerror("I/O 错误", f"读取源文件表头失败: {e}")  # 弹窗提示加载失败异常

    def choose_save_file(self):
        """打开系统保存文件对话框，选择溯源属性导出的存储路径与格式"""
        file_path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV 表格 (Join 专用)", "*.csv"), ("Excel 文件", "*.xlsx")],
            title="选择保存格式"
        )
        if file_path: self.save_path.set(file_path)  # 如果用户确认则更新路径变量

    def stop_download(self):
        """通过销毁任务时间戳标记，触发后台线程的主动阻断退出"""
        self.current_task_id = None  # 将当前任务 ID 置空，后台循环在比对时会检测到并退出
        self.log("指令触发：执行流阻断。")
        self.btn_stop.config(state=tk.DISABLED, text="⏹ 中止任务")  # 禁用中止按钮
        self.btn_run.config(state=tk.NORMAL, text="▶ 执行 ID 溯源提取")  # 恢复运行按钮状态
        self.is_downloading = False  # 标记当前任务已结束
        self.lbl_prog.config(text="状态: 阻断")  # 更新状态标签

    def build_id_batch_query(self, id_list, timeout_val=120):
        """根据传入的 ID 批次列表构建 Overpass QL 批量查询语句，提取三种要素的 tags"""
        ids_str = ",".join(map(str, id_list))  # 将整数列表合并为逗号分隔的字符串
        query = f"[out:json][timeout:{timeout_val}];\n(\n"  # 指定返回 JSON 格式以及查询超时时限
        query += f"  node(id:{ids_str});\n"  # 检索属于该批次 ID 的所有点要素
        query += f"  way(id:{ids_str});\n"  # 检索属于该批次 ID 的所有线要素
        query += f"  relation(id:{ids_str});\n"  # 检索属于该批次 ID 的所有关系要素
        query += ");\nout tags;\n"  # 仅请求提取要素的标签属性，不下载空间坐标，大幅缩减带宽与网络延迟
        return query

    def rotate_server(self):
        """轮换当前使用的 Overpass 节点，用于应对 429 限流或节点异常"""
        self.current_server_idx = (self.current_server_idx + 1) % len(self.server_pool)  # 循环后移索引
        return self.server_pool[self.current_server_idx]  # 返回切换后的节点地址

    def update_progress(self):
        """更新处理进度条，网络批处理阶段占整体进度的 80%"""
        self.processed_chunks += 1  # 已处理切片数自增 1
        progress_val = int((self.processed_chunks / self.total_chunks) * 80)  # 按比例换算至 0~80 的区间
        self.progress['value'] = progress_val  # 更新进度条数值
        self.lbl_prog.config(text=f"状态: 数据批处理 ({self.processed_chunks}/{self.total_chunks})")  # 刷新状态文字
        self.root.update_idletasks()  # 立即刷新界面

    def fetch_batch(self, id_batch, task_id, cache_dir, batch_idx):
        """向服务端请求单批次 ID 的 OSM 属性数据，包含多次重试、故障转移与限流处理机制"""
        if self.current_task_id != task_id: return None  # 检测任务是否已被用户手动终止

        query = self.build_id_batch_query(id_batch)  # 动态组装当前批次的 Overpass QL 脚本
        max_attempts = 5  # 单批次网络请求最大容错重试次数
        attempt = 0  # 当前重试计数器

        while attempt < max_attempts:
            if self.current_task_id != task_id: return None  # 每次重试前校验任务存活状态
            endpoint = self.server_pool[self.current_server_idx]  # 获取当前指派的节点
            attempt += 1  # 尝试计数自增

            try:
                proxies = {'http': self.proxy, 'https': self.proxy} if self.proxy else None  # 配置代理字典
                resp = requests.post(endpoint, data=query, headers={'User-Agent': 'V41-ID-Fetcher'}, proxies=proxies,
                                     timeout=150)  # 发起 HTTP POST 请求

                if resp.status_code == 200:  # 请求成功
                    try:
                        data = resp.json()  # 解析返回的 JSON 响应体
                    except json.JSONDecodeError:  # 响应内容非标准 JSON，可能服务器返回了错误 HTML 页面
                        if "remark" in resp.text:
                            self.log(f"批次 [{batch_idx}]：服务端内部异常，重试。")
                            time.sleep(5)  # 等待 5 秒后重试
                            continue
                        else:
                            raise ValueError("JSON 畸形")  # 抛出异常由外层重试机制捕获

                    if "remark" in data:  # 响应体中若含有 remark 说明服务端执行超时或内存超载
                        self.log(f"批次 [{batch_idx}]：配额异常 - {data['remark'][:50]}")
                        time.sleep(10)  # 稍微延长休眠时间
                        self.rotate_server()  # 切换节点并重试
                        continue

                    if not data.get("elements"):  # 若 elements 为空，表示该批 ID 在云端无记录
                        self.log(f"批次 [{batch_idx}]：云端未检索到该批次 ID，可能已被物理删除。")
                        self.update_progress()
                        return None

                    # 将成功获取的该批次数据以 JSON 文件固化至临时缓存目录，释放内存占用
                    temp_file = os.path.join(cache_dir, f"BATCH_{batch_idx}.json")
                    with open(temp_file, 'w', encoding='utf-8') as f:
                        json.dump(data, f)
                    self.log(f"批次 [{batch_idx}]：解析成功，返回 {len(data['elements'])} 条记录。")
                    self.update_progress()
                    return temp_file  # 返回生成的缓存文件路径

                elif resp.status_code == 429 or "too many requests" in resp.text.lower():  # 遭遇 Overpass API 频控
                    self.log(f"批次 [{batch_idx}]：触发限流，休眠 60 秒。")
                    time.sleep(60)  # 挂起当前线程等待限流窗口重置
                    self.rotate_server()  # 更换服务器节点尝试绕过单 IP/端点并发限制
                    attempt = max(0, attempt - 1)  # 限流不计入致命错误次数
                    continue

                else:
                    self.rotate_server()  # 其它非 200 响应切换服务器
                    time.sleep(5)

            except Exception as e_req:  # 捕获网络连接超时、断开等异常
                self.rotate_server()  # 节点故障，轮换下一个节点
                time.sleep(5)  # 休眠 5 秒后重试

        self.log(f"批次 [{batch_idx}]：超容错阈值，跳过该批次。")  # 达到最大重试上限，宣告该批失败
        self.update_progress()
        return None

    def start_download(self):
        """参数前置校验，初始化工作状态，并在后台守护线程中拉起数据处理主流程"""
        in_file = self.input_file.get().strip()  # 获取输入的源文件路径
        id_col = self.combo_id_col.get().strip()  # 获取选中的 ID 字段名
        keep_fields = self.entry_keep_fields.get().strip()  # 获取用户填写的保留属性字段列表
        out_path = self.save_path.get().strip()  # 获取用户指定的导出目标路径

        if not in_file or not id_col or not out_path:
            messagebox.showerror("参数缺失", "请完善输入文件、ID 字段及输出路径配置。")
            return

        user_endpoint = self.server_combo.get()  # 获取用户手动选择的首选服务器
        if user_endpoint in self.server_pool: self.server_pool.remove(user_endpoint)
        self.server_pool.insert(0, user_endpoint)  # 将该服务器提升至节点池首位优先调用
        self.current_server_idx = 0

        self.current_task_id = time.time()  # 以当前时间戳生成全局唯一任务 ID
        self.btn_run.config(state=tk.DISABLED, text="执行中...")  # 锁定运行按钮
        self.btn_stop.config(state=tk.NORMAL, text="⏹ 中止任务")  # 激活中断按钮
        self.is_downloading = True  # 切换下载中状态
        self.progress['value'] = 0  # 重置进度条为 0

        self.log_area.config(state="normal")  # 清空旧日志记录
        self.log_area.delete(1.0, tk.END)
        self.log_area.config(state="disabled")

        # 启动后台守护线程，避免阻塞 GUI 导致程序假死
        threading.Thread(target=self.core_pipeline, args=(in_file, id_col, keep_fields, out_path, self.current_task_id),
                         daemon=True).start()

    def core_pipeline(self, in_file, id_col, keep_fields, out_path, task_id):
        """核心处理管线：负责源文件读取、无限精度 ID 清洗去重、分片调度、多批次拉取、属性展平、数据清洗与固化"""
        self.proxy = self.entry_proxy.get().strip() if self.use_proxy.get() else None  # 提取代理配置
        base_dir = os.path.dirname(out_path)  # 提取导出目录路径
        cache_dir = os.path.join(base_dir, "OSM_ID_BATCH_Cache")  # 拼接临时缓存文件夹路径
        if not os.path.exists(cache_dir): os.makedirs(cache_dir)  # 创建缓存文件夹

        self.log("挂载 I/O 进行全量源文件读取...")
        try:
            ext = os.path.splitext(in_file)[1].lower()  # 提取输入文件后缀
            if ext == '.csv':
                df_src = pd.read_csv(in_file, usecols=[id_col])  # 仅加载指定 ID 列，节约内存
            elif ext == '.xlsx':
                df_src = pd.read_excel(in_file, usecols=[id_col])  # 仅加载指定 ID 列
            else:
                df_src = gpd.read_file(in_file)  # 读取矢量图层全量数据

            if id_col not in df_src.columns:
                raise ValueError(f"指定字段 {id_col} 不存在于数据域中。")  # 字段安全性校验

            # 核心机制：将输入 ID 列全量转为字符串列表，脱离底层 C-Int32 限制，启用 Python 原生无限精度整数映射
            raw_values = df_src[id_col].dropna().astype(str).tolist()
            unique_ids = set()  # 使用集合去重

            for val in raw_values:
                try:
                    # 兼容类似 "-12345"（负值通常由某些 GIS 工具生成）或 "12345.0" 的浮点数字符串
                    num = int(abs(float(val)))
                    if num > 0:
                        unique_ids.add(num)
                except ValueError:
                    # 退化降级容错：针对包含乱码或特殊前缀的字符，正则化剔除非数字特征提取 ID
                    digits = ''.join(filter(str.isdigit, val))
                    if digits:
                        unique_ids.add(int(digits))

            clean_ids = list(unique_ids)  # 转为清洗后的纯净整数列表
            total_ids = len(clean_ids)  # 统计总有效独立 ID 数
            self.log(f"ID 精度映射完成。提取有效独立主键总量：{total_ids}。")

        except Exception as e:
            self.log(f"源文件流解析错误: {e}")
            self.cleanup_and_reset(task_id, cache_dir, [])
            return

        if total_ids == 0:  # 校验是否有可用要素
            self.log("逻辑终止：有效 ID 集为空。")
            self.cleanup_and_reset(task_id, cache_dir, [])
            return

        chunk_size = 1000  # 设置单批次查询切片大小（1000 个 ID 是 Overpass 效率与稳定性的平衡点）
        id_chunks = [clean_ids[i:i + chunk_size] for i in range(0, total_ids, chunk_size)]  # 对 ID 列表切片分包
        self.total_chunks = len(id_chunks)  # 计算总批次切片数
        self.processed_chunks = 0  # 重置已处理批次计数

        self.log(f"系统阵列划分：进入网络批处理协议，共划分为 {self.total_chunks} 个通信区块。")

        json_files = []  # 存储成功生成的本地缓存 JSON 路径
        for idx, chunk in enumerate(id_chunks):
            if self.current_task_id != task_id: return  # 校验任务是否被用户中止
            res_file = self.fetch_batch(chunk, task_id, cache_dir, idx + 1)  # 抓取单批次数据并落地为缓存文件
            if res_file: json_files.append(res_file)

        if self.current_task_id != task_id: return  # 校验是否中止

        if not json_files:
            self.log("网络检索终止：全量主键在云端未能命中有效实体。")
            self.cleanup_and_reset(task_id, cache_dir, json_files)
            return

        self.log("启动 JSON 属性展平架构...")
        try:
            dfs = []  # 暂存各批次转成的 DataFrame
            for idx, fp in enumerate(json_files):
                if self.current_task_id != task_id: return  # 校验是否中止
                try:
                    with open(fp, 'r', encoding='utf-8') as f:
                        data = json.load(f)  # 加载 JSON 缓存文件

                    elements = data.get("elements", [])
                    if elements:
                        records = []
                        for el in elements:
                            # 提取核心标识列：osm_id 与 osm_type (node/way/relation)
                            record = {"osm_id": el["id"], "osm_type": el["type"]}
                            tags = el.get("tags", {})  # 提取该要素的所有业务 tags 属性字典
                            record.update(tags)  # 将业务 tags 平铺展开至同一字典中
                            records.append(record)

                        df = pd.DataFrame(records)  # 转换为单批次的 DataFrame
                        dfs.append(df)
                except Exception:
                    pass  # 遇到个别异常缓存文件跳过，保证大盘数据处理稳定

                # 更新后半程进度条（从 80% 推进至 95%）
                self.progress['value'] = 80 + int(((idx + 1) / len(json_files)) * 15)
                self.root.update_idletasks()

            if not dfs:
                self.log("装配错误：内存栈为空。")
                self.cleanup_and_reset(task_id, cache_dir, json_files)
                return

            final_df = pd.concat(dfs, ignore_index=True)  # 将所有分块 DataFrame 纵向拼装
            self.log(f"合并通过。映射成功数：{len(final_df)}。")

        except Exception as e_parse:
            self.log(f"内存溢出: {e_parse}")
            self.cleanup_and_reset(task_id, cache_dir, json_files)
            return

        self.log("执行物理清洗策略。")

        # 联合主键去重：确保同一 ID 和要素类型组合全局唯一
        final_df = final_df.drop_duplicates(subset=['osm_id', 'osm_type'])
        # 列名清洗：替换 OSM 常见的冒号命名（如 name:zh -> name_zh），避免 GIS 驱动与数据库命名冲突
        final_df.columns = [str(c).replace(':', '_') for c in final_df.columns]
        # 删除由于名称替换可能引发的重名列
        final_df = final_df.loc[:, ~final_df.columns.duplicated()]

        if keep_fields:
            # 用户指定了字段清洗列表
            user_fields = [f.strip().replace(':', '_') for f in keep_fields.split(',') if f.strip()]
            core_ids = ['osm_id', 'osm_type']
            for cid in core_ids:
                if cid not in user_fields: user_fields.insert(0, cid)  # 强制保留 osm_id 和 osm_type

            existing_fields = [f for f in user_fields if f in final_df.columns]  # 取交集保留真实存在的列
            final_df = final_df[existing_fields]  # 切片过滤
        else:
            final_df.dropna(axis=1, how='all', inplace=True)  # 若无输入，直接剔除全为空值的无效字段

        # 文本数据消毒：清除字段中存在的特殊控制符（换行符、回车符、制表符），替换为单个空格，防止破坏 CSV 结构
        for col in final_df.columns:
            if final_df[col].dtype == object:
                mask = final_df[col].notna()
                final_df.loc[mask, col] = final_df.loc[mask, col].astype(str).str.replace(r'[\r\n\t]', ' ', regex=True)
                # 将文本化的假空值统统重置还原为标准空值 None
                final_df[col] = final_df[col].replace({'None': None, 'nan': None, '<NA>': None, '': None})

        # --- 导出持久化阶段 ---
        ext = os.path.splitext(out_path)[1].lower()  # 提取输出目标文件扩展名
        try:
            current_row_count = len(final_df)
            # Excel 单 Sheet 上限检查：行数超过 1,048,575 行时强行自动分流至 CSV 格式，防止 Excel 导出崩溃
            if ext == '.xlsx' and current_row_count > 1048575:
                self.log("路由拦截：变更为 CSV 防止 Excel 越界。")
                out_path = os.path.splitext(out_path)[0] + '.csv'
                final_df.to_csv(out_path, index=False, encoding='utf-8-sig')  # 导出带 BOM 的 UTF-8 CSV
            elif ext == '.csv':
                final_df.to_csv(out_path, index=False, encoding='utf-8-sig')  # 导出 CSV
            elif ext == '.xlsx':
                final_df.to_excel(out_path, index=False)  # 导出标准 Excel
            else:
                out_path = os.path.splitext(out_path)[0] + '.csv'
                final_df.to_csv(out_path, index=False, encoding='utf-8-sig')  # 其它未识别后缀默认导出为 CSV

            self.log(f"I/O 挂载释放。")
            messagebox.showinfo("状态确认", f"精准溯源完成。\n覆盖命中记录：{current_row_count}。\n支持基于 osm_id 回接。")
        except Exception as e_save:
            self.log(f"I/O 崩溃: {e_save}")  # 捕获保存时的权限冲突或路径异常

        self.cleanup_and_reset(task_id, cache_dir, json_files)  # 清理缓存并重置界面状态

    def cleanup_and_reset(self, task_id, cache_dir, json_files):
        """清理临时生成的缓存分块文件，并复原界面上的操作按钮状态"""
        if self.current_task_id == task_id:
            try:
                # 遍历删除本地落地的临时分片 JSON 文件
                for f in json_files:
                    if os.path.exists(f): os.remove(f)
            except:
                pass  # 忽略部分临时文件因被占用无法立即删除的异常
            self.btn_run.config(state=tk.NORMAL, text="▶ 执行 ID 溯源提取")  # 恢复运行按钮可点击
            self.btn_stop.config(state=tk.DISABLED, text="⏹ 中止任务")  # 禁用中止按钮
            self.is_downloading = False  # 重置下载状态
            self.lbl_prog.config(text="状态: 待机")  # 状态恢复待机
            self.progress['value'] = 100  # 进度条填满标记流程结束


